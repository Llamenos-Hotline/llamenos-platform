# orchestrator/systemd/llamenos-fleet-tick.service
[Unit]
Description=Llámenos fleet — one dispatch pass
After=network-online.target

[Service]
Type=oneshot
# %h is the unit owner's home directory (these are systemd USER units). There is
# deliberately no WorkingDirectory=: the wrapper installed at
# %h/.local/bin/llamenos-fleet is a symlink into the repo checkout and cd's there
# itself (see orchestrator/bin/llamenos-fleet), so the checkout can live anywhere.
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.llamenos-fleet/env
ExecStart=%h/.local/bin/llamenos-fleet tick
# A pass that cannot run is not a failure: the lock, the halt file and the
# breakers all exit cleanly on purpose, so systemd must not treat a quiet night
# as a fault and back off.
SuccessExitStatus=0
# Sized as: tick.ts's MAX_PASS_LIVE_DISPATCH_START_MS (60min — no NEW live
# dispatch starts past it) + one worst-case in-flight item (90min worker +
# poll grace + two verify/review rounds) + headroom. The 7200s this replaced
# never accounted for the review loop: a single heavy item could overrun it,
# and two items overran it every time — systemd SIGKILLed the pass
# mid-pipeline and orphaned the worker (2026-10-11: two consecutive kills,
# no tick completing for 2h). The two bounds are one invariant; change them
# together.
TimeoutStartSec=14400
