# Multi-stage Dockerfile for Llamenos (Node.js self-hosted mode)
#
# NOTE: Using Node.js instead of Bun because the VPS CPU lacks AVX support

# Stage 1: Install runtime deps
# node:26-slim digest pinned 2026-05-18 — update via scripts/update-image-digests.sh
FROM node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1 AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*

# Install Bun with version pin and SHA-256 verification.
# To update: download the new version zip, verify with sha256sum, update both ARGs.
# sha256sum obtained via:
#   curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v1.3.5/bun-linux-x64.zip" -o /tmp/bun.zip && sha256sum /tmp/bun.zip
ARG BUN_VERSION=1.3.5
ARG BUN_SHA256=7051d86a924aefea3e0b96213b5fd8f79c0793f9cae6534233e627e5c3db4669
RUN curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
      -o /tmp/bun.zip \
    && echo "${BUN_SHA256}  /tmp/bun.zip" | sha256sum -c - \
    && unzip /tmp/bun.zip -d /tmp/bun-extract \
    && mv /tmp/bun-extract/bun-linux-x64/bun /usr/local/bin/bun \
    && rm -rf /tmp/bun.zip /tmp/bun-extract \
    && chmod +x /usr/local/bin/bun

COPY package.json bun.lockb ./
COPY packages/crypto/package.json packages/crypto/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/test-specs/package.json packages/test-specs/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY site/package.json site/package.json
RUN bun install --frozen-lockfile --production --ignore-scripts

# Stage 2: Build Rust crypto FFI (.so)
FROM rust:1-slim AS rust-builder
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY packages/crypto/ packages/crypto/
RUN cargo build --release --manifest-path packages/crypto/Cargo.toml --features server \
    && mkdir -p packages/crypto/dist/server \
    && cp packages/crypto/target/release/libllamenos_core.so packages/crypto/dist/server/

# Stage 3: Production
FROM node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd -r llamenos && useradd -r -g llamenos -d /app -s /sbin/nologin llamenos
WORKDIR /app
COPY package.json ./
COPY --from=deps /app/node_modules/ node_modules/
COPY src/ src/
COPY apps/worker/ apps/worker/
COPY packages/shared/ packages/shared/
COPY packages/i18n/ packages/i18n/
COPY packages/protocol/ packages/protocol/
COPY packages/crypto/package.json packages/crypto/package.json
COPY packages/crypto/ffi.ts packages/crypto/ffi.ts
COPY tsconfig.json ./
COPY --from=rust-builder /build/packages/crypto/dist/server/libllamenos_core.so packages/crypto/dist/server/
COPY drizzle/migrations/ drizzle/migrations/
COPY scripts/run-migrations.ts scripts/run-migrations.ts
COPY deploy/docker/docker-entrypoint-nodejs.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
COPY deploy/docker/download-page/ public/
RUN npm install -g tsx && chown -R llamenos:llamenos /app
USER llamenos
ENV PLATFORM=node PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://localhost:3000/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))" || exit 1
ENTRYPOINT ["docker-entrypoint.sh"]
CMD []
