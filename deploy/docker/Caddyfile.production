# Production Caddyfile for Llamenos — Tier 4 split-origin layout.
#
# Requires these env vars (set in .env and passed into the caddy container):
#   APP_DOMAIN    — e.g. app.llamenos.example     (SPA static files)
#   API_DOMAIN    — e.g. api.llamenos.example     (Bun/Hono backend)
#   CRYPTO_DOMAIN — e.g. crypto.llamenos.example  (sandboxed crypto iframe)
#   ACME_EMAIL    — contact for Let's Encrypt
#
# The caddy container is built from deploy/docker/Dockerfile with
# `target: static`, which bakes the built SPA into /srv/app/ and swaps in a
# custom xcaddy-built Caddy binary (for the rate_limit directive below).
# Only api.* proxies to app:3000; app.* and crypto.* are pure file_servers
# on distinct origins.
#
# WHICH DEPLOY PATH THIS IS. This file is the ingress of the Docker Compose
# path (docker-compose.yml + docker-compose.production.yml). The Ansible deploy
# in deploy/ansible/ does NOT read it: that path renders
# deploy/ansible/roles/llamenos-caddy/templates/caddy.j2, which serves the API
# (and the updater origin) only, with no SPA or crypto origin. The two files
# describe different layouts, but they MUST agree on every security directive
# they share. Change one, change the other.
#
# COMPRESSION (#3018). `encode` appears ONLY on the two file_server origins
# (app.*, crypto.*): they serve the same public, content-hashed bytes to
# everyone, so compressing them leaks nothing. It is deliberately ABSENT from
# every origin that proxies a backend — above all api.*, and caddy.j2 omits it
# for the same reason. API responses carry session tokens, WebAuthn challenges
# and sealed envelopes alongside caller- and attacker-influenced content;
# compressing that makes response length an oracle on the secret
# (BREACH/CRIME). And it would buy almost nothing: sealed payloads are
# ciphertext, which does not compress. Enforced for every Caddy config in the
# repo by deploy/ansible/scripts/check-caddy-compression.py.
#
# KNOWN GAP: /srv/crypto/ (the sandboxed crypto iframe served at
# crypto.$CRYPTO_DOMAIN) is currently EMPTY — that app was developed on an
# unmerged branch and never landed on main. crypto.* will 404 until it is
# merged and wired into the `static` Docker stage. See that stage's comment
# in deploy/docker/Dockerfile for detail.
{
	email {$ACME_EMAIL}
}

# ─── SPA origin — app.<parent> ─────────────────────────────────────
{$APP_DOMAIN} {
	root * /srv/app
	encode gzip zstd
	file_server
	try_files {path} /index.html

	# Immutable assets (content-hashed filenames from Vite build)
	@immutable {
		path /assets/*
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML — always revalidate
	@html {
		path *.html /
	}
	header @html Cache-Control "no-cache"

	header {
		# Tier 4 PR-A: SPA CSP is strict — only self-hosted JS/CSS + the
		# crypto iframe (from crypto.*) + API connections to api.*.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN}; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; frame-src https://{$CRYPTO_DOMAIN}; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types llamenos default; report-uri https://{$API_DOMAIN}/api/csp-report; upgrade-insecure-requests"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Permitted-Cross-Domain-Policies "none"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}
}

# ─── API origin — api.<parent> ──────────────────────────────────────
{$API_DOMAIN} {
	# NO `encode` here, on purpose — see COMPRESSION at the top of this file.
	# The mobile HTTP stacks (OkHttp, URLSession) and browsers send
	# Accept-Encoding by default, so an `encode` line would compress nearly
	# every authenticated API response, not just the large ones. There is no
	# safe subset to carve out: the large responses (note, conversation and
	# contact listings) are exactly the ones made of sealed envelopes.

	# Auth endpoint rate limiting — strict (login, register, WebAuthn).
	# Requires the caddy-ratelimit plugin (github.com/mholt/caddy-ratelimit),
	# built into the caddy image via xcaddy — see deploy/docker/Dockerfile's
	# `caddy-builder` stage. Per-client key ({remote_host}) so one abusive
	# IP cannot exhaust another client's quota.
	rate_limit {
		zone auth_limit {
			match {
				path /api/auth/*
			}
			key    {remote_host}
			events 10
			window 1m
		}
		zone register_limit {
			match {
				path /api/register
			}
			key    {remote_host}
			events 5
			window 1m
		}
	}

	# CORS enforcement — allow only the SPA origin for credentialed requests.
	# Hono middleware sets the final CORS headers for actual requests;
	# Caddy handles the OPTIONS preflight to fail-fast on disallowed origins.
	@cors-preflight {
		method OPTIONS
	}
	handle @cors-preflight {
		header Access-Control-Allow-Origin "https://{$APP_DOMAIN}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization, X-Request-ID"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	# Everything else → Hono backend
	handle {
		reverse_proxy app:3000
	}

	header {
		# The Hono securityHeaders middleware already emits a hard
		# `default-src 'none'; script-src 'none'` CSP on every response.
		# Caddy-level headers here are belt-and-suspenders for routes
		# that bypass middleware (e.g. health probes served by Caddy).
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}
}

# ─── Crypto sandbox origin — crypto.<parent> ────────────────────────
{$CRYPTO_DOMAIN} {
	root * /srv/crypto
	encode gzip zstd
	file_server
	try_files {path} /sandbox.html

	# Immutable assets (content-hashed filenames from Vite build)
	@immutable {
		path /assets/*
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		# Iframe-only CSP. HARD INVARIANT: `connect-src 'none'` — the crypto
		# sandbox is an offline oracle. Ciphertext flows in via postMessage,
		# plaintext flows out via postMessage. ZERO network. Never widen this
		# to 'self' or api.*; doing so would break the Tier 4 threat model.
		# `style-src 'self'` matches the sandbox.html meta CSP (no inline
		# styles are used, but `'none'` forbids even the <link rel=stylesheet>
		# we ship in the bundle). `script-src` adds 'wasm-unsafe-eval' so
		# noble/whisper WASM modules can instantiate once crypto wiring lands.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://{$APP_DOMAIN}; require-trusted-types-for 'script'; trusted-types llamenos-sandbox default; report-uri https://{$API_DOMAIN}/api/csp-report"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		# CORP must be 'cross-origin' — the SPA host sets COEP: require-corp,
		# which means the iframe fetch must opt in via CORP: cross-origin.
		# frame-ancestors restricts who can embed; CORP allows the fetch to
		# succeed. 'same-origin' would block the cross-origin iframe load.
		Cross-Origin-Resource-Policy "cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# X-Frame-Options intentionally omitted — the crypto sandbox MUST be
		# embeddable by app.* as an iframe. The CSP frame-ancestors directive
		# above is the correct mechanism for restricting embedders in modern
		# browsers. X-Frame-Options:DENY would break the Tier 4 split-origin.
		Referrer-Policy "no-referrer"
		X-Permitted-Cross-Domain-Policies "none"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}
}

# ─── Downloads origin — downloads.<parent> ────────────────────────
# Serves desktop release artifacts (AppImage, DMG, EXE, checksums)
# from the RustFS /releases/ bucket. Files are public; no auth needed.
{$DOWNLOADS_DOMAIN} {
	# No `encode`: this origin proxies object storage (see COMPRESSION at the
	# top), and what it serves — installers and checksums — is already
	# compressed or too small to matter.

	# Proxy to RustFS S3 API for /releases/ bucket
	handle /releases/* {
		reverse_proxy rustfs:9000 {
			header_up Host rustfs:9000
		}
		uri strip_prefix /releases
	}

	# Default: redirect / to latest release page on GitHub
	handle {
		redir https://github.com/llamenos/llamenos/releases/latest permanent
	}

	header {
		# Static file CSP — no scripts, no frames
		Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'none'; img-src 'self'; font-src 'none'; connect-src 'none'; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}
}

# ─── Updates origin — updates.<parent> ────────────────────────────
# Serves Tauri updater metadata and signature files from RustFS.
# The Tauri updater polls this endpoint for new versions.
{$UPDATES_DOMAIN} {
	# No `encode`: this origin proxies object storage (see COMPRESSION at the
	# top), and what it serves — signed updater bundles (already compressed
	# archives), their .sig files and latest.json (a few hundred bytes) — gains
	# nothing from it. caddy.j2's updater vhost does not compress either.

	# Staging bucket — pre-release builds for testing
	handle /staging/* {
		reverse_proxy rustfs:9000 {
			header_up Host rustfs:9000
		}
		uri strip_prefix /staging
	}

	# Releases bucket — production updater artifacts
	handle /releases/* {
		reverse_proxy rustfs:9000 {
			header_up Host rustfs:9000
		}
		uri strip_prefix /releases
	}

	# Updater JSON endpoint — serves latest version metadata
	handle /latest.json {
		reverse_proxy rustfs:9000 {
			header_up Host rustfs:9000
		}
	}

	header {
		# Allow CORS from app.* origin for updater checks
		Access-Control-Allow-Origin "https://{$APP_DOMAIN}"
		Access-Control-Allow-Methods "GET, HEAD"
		Vary "Origin"

		# Updater metadata CSP — static JSON/sig files only, no scripts or frames
		Content-Security-Policy "default-src 'none'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		-Server
	}
}
