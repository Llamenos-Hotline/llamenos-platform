# TLS domains for Kamailio's client-facing listener (listen=tls:…:5061).
#
# TEMPLATE. kamailio-entrypoint.sh substitutes the @…@ placeholders below and
# writes the result to /etc/kamailio/tls.cfg, which is where kamailio.cfg's
# `modparam("tls", "config", …)` reads from. Rendering rather than mounting is
# what lets the certificate and key paths be configured per deployment:
# tls.cfg has no include mechanism and no variable expansion of its own, so a
# literal path here would be the only path possible.
#
# The default domain serves every connection Kamailio terminates: native SIP
# clients (Linphone) register over TLS here and Kamailio relays to the
# Asterisk backend, which is the registrar.
#
# certificate/private_key come from KAMAILIO_TLS_CERT_FILE and
# KAMAILIO_TLS_KEY_FILE. Both default to /etc/kamailio/cert.pem — one combined
# PEM, generated self-signed by kamailio-entrypoint.sh when the operator has
# not supplied a real one. They are two settings rather than one because an
# ACME certificate is two files: Caddy stores `<domain>.crt` + `<domain>.key`,
# certbot `fullchain.pem` + `privkey.pem`, and neither can be named by a
# single path.
#
# method is TLSv1.2+ rather than the module default (TLSv1.2 exactly): the
# fixed-1.2 default trips "no suitable signature algorithm" against OpenSSL 3
# clients (Kamailio 5.7.1 + OpenSSL 3.0), which refuse the handshake.
[server:default]
method = TLSv1.2+
certificate = @KAMAILIO_TLS_CERT_FILE@
private_key = @KAMAILIO_TLS_KEY_FILE@
