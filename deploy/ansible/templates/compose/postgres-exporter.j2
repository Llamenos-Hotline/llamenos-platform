name: llamenos-postgres-exporter

services:
  postgres-exporter:
    image: {{ postgres_exporter_image | default('quay.io/prometheuscommunity/postgres-exporter:v0.15.0') }}
    restart: unless-stopped
    environment:
      # llamenos-internal-only: the postgres-exporter container is never on
      # llamenos-web, so this connection string is reachable only from other
      # containers on the internal network (prometheus, same as the app).
      - DATA_SOURCE_NAME=postgresql://llamenos:{{ pg_password }}@postgres:5432/llamenos?sslmode=disable
    networks:
      - llamenos-internal
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  llamenos-internal:
    external: true
  llamenos-observability:
    external: true
