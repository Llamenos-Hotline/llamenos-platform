name: llamenos-grafana

services:
  grafana:
    image: {{ grafana_image | default('grafana/grafana-oss:11.5.2') }}
    restart: unless-stopped
    volumes:
      # The role writes provisioning/{datasources,dashboards}/llamenos.yml and
      # dashboards/*.json. This used to name ./datasources.yml and
      # ./dashboard-provider.yml — paths nothing ever creates, so Docker made
      # each one a DIRECTORY and Grafana provisioned nothing; the dashboards
      # tree was not mounted at all, while dashboard-provider.yml.j2 pointed the
      # file provider at /var/lib/grafana/dashboards inside the empty named
      # volume (issue #1602, finding 13). Mount the trees, not invented files.
      - ./provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
      - ./dashboards:/var/lib/grafana/dashboards:ro
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_USERS_ALLOW_SIGN_UP={{ grafana_allow_signup | default(false) | string | lower }}
    networks:
      - llamenos-web
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  grafana-data:

networks:
  llamenos-web:
    external: true
  llamenos-observability:
    external: true
