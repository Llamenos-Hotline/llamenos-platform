name: llamenos-prometheus

services:
  prometheus:
    image: {{ prometheus_image | default('prom/prometheus:v3.2.1') }}
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      # The rules role templates to rules/llamenos.yml (tasks/main.yml), and
      # prometheus.yml's `rule_files: [/etc/prometheus/rules/*.yml]` expects a
      # DIRECTORY here. The old single-file bind (./alert-rules.yml, a path
      # that never existed on the host) made Docker auto-create it as an empty
      # directory, so the glob matched nothing and all 3 alert rules silently
      # never loaded, no matter how AppDown/HighMemoryUsage/HighDiskUsage read
      # in the template (#1148). Verified with `docker run -v
      # <missing-file>:<path>` reproducing the empty-directory behavior.
      - ./rules:/etc/prometheus/rules:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention | default('15d') }}'
      - '--storage.tsdb.retention.size={{ prometheus_retention_size | default('5GB') }}'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
      - '--web.enable-lifecycle'
    networks:
      - llamenos-internal
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  prometheus-data:

networks:
  llamenos-internal:
    external: true
  llamenos-observability:
    external: true
