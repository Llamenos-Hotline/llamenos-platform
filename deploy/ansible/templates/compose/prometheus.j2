name: llamenos-prometheus

services:
  prometheus:
    image: {{ prometheus_image | default('prom/prometheus:v3.2.1') }}
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      # The role templates its rules to rules/llamenos.yml. This used to mount
      # ./alert-rules.yml — a path nothing creates — so Docker made it a
      # DIRECTORY at /etc/prometheus/rules/alert-rules.yml, prometheus.yml's
      # `rules/*.yml` glob matched that directory, and Prometheus restart-looped
      # on "is a directory ... error loading rules, previous rule set restored".
      # The alert rules therefore never loaded (issue #1602, finding 14).
      - ./rules:/etc/prometheus/rules:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention | default('15d') }}'
      - '--storage.tsdb.retention.size={{ prometheus_retention_size | default('5GB') }}'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
      - '--web.enable-lifecycle'
    networks:
      - llamenos-internal
      - llamenos-observability
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  prometheus-data:

networks:
  llamenos-internal:
    external: true
  llamenos-observability:
    external: true
