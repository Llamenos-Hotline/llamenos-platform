# Real deployment inputs — never commit. The tracked vars.yml / inventory.yml are
# templates/placeholders; put real values in the *-production files below.
vars-production.yml
inventory-production.yml
# Decrypted vault material / editor leftovers
*.vault-pass
.vault-pass
vars-production.yml.*
inventory-production.yml.*
# Staging deploy inputs, kept out of git exactly like the production pair above.
vars-staging.yml
inventory-staging.yml
vars-staging.yml.*
inventory-staging.yml.*
.roundtrip-inventory.yml
# Python bytecode Ansible writes the first time it loads filter_plugins/.
__pycache__/
