# Real deployment inputs — never commit. The tracked vars.yml / inventory.yml are
# templates/placeholders; put real values in the *-production files below.
vars-production.yml
inventory-production.yml
# Decrypted vault material / editor leftovers
*.vault-pass
.vault-pass
vars-production.yml.*
inventory-production.yml.*
# A deploy workflow writes a vars file and an inventory into the checkout on a
# SELF-HOSTED runner and only removes them in an `if: always()` step. A killed
# job left an untracked, un-ignored vault file and a real inventory in the
# worktree. (The demo_vars.yml / inventory-demo.yml pair these patterns were
# written for went with demo mode in #1604; the staging equivalents are the
# vars-staging / inventory-staging names below.)
vars-staging.yml
inventory-staging.yml
vars-staging.yml.*
inventory-staging.yml.*
