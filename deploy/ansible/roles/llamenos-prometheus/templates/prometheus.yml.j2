# Prometheus Configuration — managed by Ansible
# Do not edit manually; changes will be overwritten on next deploy.

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    cluster: llamenos
    environment: {{ app_environment | default('production') }}

rule_files:
  - /etc/prometheus/rules/*.yml

{% if alertmanager_enabled | default(true) %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093
{% endif %}

scrape_configs:
  # ── Prometheus self-monitoring ────────────────────────
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # ── Llamenos application ──────────────────────────────
  #
  # Two things were wrong here until #1624, and each alone made this job
  # collect nothing — measured against a live deployment:
  #
  #   path  /api/metrics is the ADMIN-ONLY JSON summary (metrics.get('/') in
  #         apps/worker/routes/metrics.ts). The Prometheus text endpoint is
  #         /api/metrics/prometheus (metrics.get('/prometheus')), and only it
  #         has a scrape-token branch at all.
  #   auth  that endpoint takes METRICS_SCRAPE_TOKEN as a bearer, or falls
  #         back to requiring a signed-in admin holding `metrics:read`. A
  #         scrape is never that, so an unauthenticated scrape got a 401 and
  #         up{job="llamenos-app"} sat at 0 with AppDown firing forever.
  #
  # The token is the same `metrics_scrape_token` the worker's .env renders
  # (templates/env/_worker-required-env.j2) — set it in one place and both
  # sides pick it up. It is asserted non-empty by playbooks/preflight.yml
  # whenever this job is active (#1148), so there is no "scrape without a
  # token" branch to render: an empty token is a refused deploy, not a job
  # that silently 401s.
{% if llamenos_app_enabled | default(true) %}
  - job_name: llamenos-app
    metrics_path: /api/metrics/prometheus
    authorization:
      type: Bearer
      credentials: {{ metrics_scrape_token | to_json }}
    static_configs:
      - targets: ["app:3000"]
        labels:
          service: app
{% endif %}

  # ── Node exporter (host metrics) ─────────────────────
{% if node_exporter_enabled | default(true) %}
  - job_name: node-exporter
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          service: node
{% endif %}

  # ── Caddy reverse proxy ───────────────────────────────
  # Caddy's admin API (port 2019) binds to loopback INSIDE its own container by
  # default and is never reachable from here -- this job was permanently down
  # from any host (#1148). roles/llamenos-caddy instead enables the dedicated
  # `metrics` HTTP handler on a plain, unauthenticated internal-only listener
  # (no public port mapping) that this job scrapes directly.
{% if llamenos_caddy_enabled | default(true) %}
  - job_name: caddy
    static_configs:
      - targets: ["caddy:9091"]
        labels:
          service: caddy
{% endif %}

  # ── PostgreSQL ───────────────────────────────────────
{% if postgres_exporter_enabled | default(true) and llamenos_postgres_enabled | default(true) %}
  - job_name: postgres
    static_configs:
      - targets: ["postgres-exporter:9187"]
        labels:
          service: postgres
{% endif %}

{% if loki_enabled | default(true) %}
  # ── Loki ─────────────────────────────────────────────
  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]
        labels:
          service: loki
{% endif %}
