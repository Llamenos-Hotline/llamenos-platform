groups:
  - name: llamenos
    rules:
      - alert: AppDown
        expr: up{job="llamenos-app"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Llamenos app is down"
          description: "The Llamenos application has been down for more than 1 minute."

      # ── WorkerStalled: scheduler-worker liveness, judged out of process ──
      #
      # A check that runs inside a worker cannot report that worker being down:
      # if erasure-expiry simply stops, a caller-erasure deadline passes with no
      # artefact anywhere (#2323). So the app only PUBLISHES two gauges per
      # scheduler worker (apps/worker/metrics/worker-liveness.ts) and this rule,
      # in a different process, decides:
      #
      #   llamenos_worker_tick_interval_seconds{worker}           published for every
      #                                                           registered worker from boot
      #   llamenos_worker_last_success_timestamp_seconds{worker}  published only once a
      #                                                           tick has completed
      #
      # Threshold: 3 x the worker's own tick interval, floored at 10 minutes so a
      # sub-minute worker's single long tick (a rate-limited blast batch) does not
      # page. The floor is derived here, from the published interval, so it can
      # never drift from the period the worker actually runs on.
      #
      # Three rules share the alert name, one per way "no evidence of work" can
      # look, distinguished by `reason`. NO DATA IS A FAILURE STATE: the second
      # and third exist precisely so that a gauge that was never published can
      # not read as healthy, which a staleness-only rule would do.
      #
      # Honest limit: this reaches whoever OPERATES the deployment, through the
      # existing Alertmanager receiver (filled at deploy time, never committed).
      # It does NOT tell hub members anything — when the process or scheduler is
      # down, the app cannot. While the app is unscrapable these stay silent and
      # AppDown carries the page instead. Selectors are by job and label only.
      - alert: WorkerStalled
        # Published, but its last completed tick is older than the threshold.
        expr: >-
          (time() - llamenos_worker_last_success_timestamp_seconds{job="llamenos-app"})
          > on(instance, job, worker)
          clamp_min(3 * llamenos_worker_tick_interval_seconds{job="llamenos-app"}, 600)
        for: 2m
        labels:
          severity: critical
          reason: stale
        annotations:
          summary: "A Llamenos scheduler worker has stopped completing ticks"
          description: >-
            The worker named in the `worker` label has not completed a tick for
            more than 3 of its intervals (10 minutes minimum). The work it does
            (erasure deadlines, retention purge, Signal retries, blast delivery,
            ...) is not happening. Check the app logs for that worker. Hub
            members are NOT notified of this by the app.

      - alert: WorkerStalled
        # Registered, but has not completed a single tick since the process
        # started, for longer than its threshold. Covers a worker that never
        # started, and one whose first tick hangs or throws every time.
        expr: >-
          (
            clamp_min(3 * llamenos_worker_tick_interval_seconds{job="llamenos-app"}, 600)
            unless on(instance, job, worker)
            llamenos_worker_last_success_timestamp_seconds{job="llamenos-app"}
          )
          < on(instance, job) group_left()
          llamenos_uptime_seconds{job="llamenos-app"}
        for: 2m
        labels:
          severity: critical
          reason: never_succeeded
        annotations:
          summary: "A Llamenos scheduler worker has never completed a tick"
          description: >-
            The worker named in the `worker` label has published no successful
            tick since the app process started, for longer than 3 of its
            intervals (10 minutes minimum). It is either not running or failing
            on every tick. Hub members are NOT notified of this by the app.

      - alert: WorkerStalled
        # The app answers scrapes but publishes no worker-liveness data at all,
        # so not one worker can be judged. Treated as a failure, never as fine.
        expr: >-
          up{job="llamenos-app"} == 1
          unless on(instance, job)
          llamenos_worker_tick_interval_seconds{job="llamenos-app"}
        for: 2m
        labels:
          severity: critical
          reason: no_liveness_metrics
        annotations:
          summary: "Llamenos app publishes no scheduler-worker liveness metrics"
          description: >-
            The app is up and scraped, but exports no
            llamenos_worker_tick_interval_seconds series, so no scheduler worker
            can be checked. Treat every background job as unverified until this
            clears.

      - alert: HighMemoryUsage
        expr: (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage"
          description: "Memory usage is above 85% for more than 5 minutes."

      - alert: HighDiskUsage
        expr: (node_filesystem_size_bytes{mountpoint="/"} - node_filesystem_avail_bytes{mountpoint="/"}) / node_filesystem_size_bytes{mountpoint="/"} * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High disk usage"
          description: "Disk usage is above 85% for more than 5 minutes."

      - alert: PostgresExporterDown
        expr: up{job="postgres"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "PostgreSQL exporter is unreachable"
          description: "postgres-exporter has been unscrapable for more than 2 minutes -- database health is unknown."

      - alert: HighErrorRate
        # 0/0 evaluates to NaN in PromQL, which compares false to any threshold,
        # so this correctly stays silent rather than firing when there is no
        # traffic at all.
        expr: >-
          sum(rate(llamenos_http_requests_total{status_class="5xx"}[5m]))
          /
          sum(rate(llamenos_http_requests_total[5m]))
          > 0.05
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Elevated 5xx error rate"
          description: "More than 5% of HTTP requests have returned a 5xx status for more than 5 minutes."

      # Deliberately NOT added here, to avoid recreating the exact "fires from
      # first boot, gets muted, outage goes unnoticed" failure this issue is
      # about (#1148):
      #   - Backup staleness / SIP bridge down: llamenos_backup_age_seconds and
      #     llamenos_sip_bridge_status are defined in metrics.ts but have ZERO
      #     production call sites, so the gauge never exists and any rule
      #     against it would be permanently true (or permanently absent,
      #     depending on phrasing) regardless of real backup/bridge health.
      #     Wiring those setters into the backup service / SIP bridge adapter
      #     is apps/worker work, out of this change's scope.
      #   - Certificate expiry: Caddy exposes no cert-expiry metric without a
      #     blackbox_exporter instance (not currently deployed); adding one is
      #     a new component, not a rule tweak.
      #   - "No calls routed in N minutes": no counter for a successfully
      #     answered/routed call exists yet (only llamenos_calls_unroutable_total,
      #     which counts routing FAILURES).
      # All three operational signals above (backup staleness, TLS expiry, and
      # container/DB health) ARE covered today, independent of these Prometheus
      # metrics, by the cron-based `alerting` role (templates/alerting/check-alerts.sh.j2)
      # -- which is why vars.yml now defaults llamenos_alerting_enabled to true
      # for the official profile alongside observability_enabled.
