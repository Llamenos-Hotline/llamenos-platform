#!/usr/bin/env bash
#
# Llamenos RustFS Backup Script — managed by Ansible
#
# Tars the RustFS data volume directly (via a throwaway container that mounts
# it read-only), then optionally encrypts the result. This does NOT depend on
# an S3 CLI (rclone/aws) being present anywhere — the rustfs/rustfs image ships
# neither, so shelling out to one inside it always silently produced an empty
# backup. Tarring the volume's bytes is also strictly more correct: it backs
# up every object RustFS actually wrote to disk, not just what an S3 list
# call happened to enumerate.
#
# Usage:
#   ./backup-rustfs.sh              # Run a daily backup
#   ./backup-rustfs.sh --manual     # Run and tag as manual backup
#   ./backup-rustfs.sh --manifest   # Output manifest entry to stdout

set -euo pipefail

BACKUP_DIR="{{ backup_rustfs_dir }}"
COMPOSE_FILE="{{ backup_compose_file }}"
AGE_RECIPIENT="{{ backup_age_public_key }}"
RCLONE_REMOTE="{{ backup_rclone_remote }}"
MIN_FREE_MB={{ backup_min_free_mb | default(1024) }}
RUSTFS_SERVICE="rustfs"
RUSTFS_VOLUME_DEST="/data"
TIMESTAMP="$(date -u +%Y%m%d-%H%M%S)"
DAY_OF_WEEK="$(date -u +%u)"
DAY_OF_MONTH="$(date -u +%d)"
MANIFEST_MODE=false

BACKUP_TYPE="daily"
for arg in "$@"; do
  case "$arg" in
    --manual) BACKUP_TYPE="manual" ;;
    --manifest) MANIFEST_MODE=true ;;
  esac
done

log() {
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [rustfs] $*"
}

TMPDIR="$(mktemp -d)"
trap 'rm -rf "${TMPDIR}"' EXIT

log "Starting ${BACKUP_TYPE} RustFS backup..."

# Step 0: Refuse to start if the backup volume is nearly full.
AVAILABLE_MB="$(df -Pm "${BACKUP_DIR}" | tail -1 | awk '{print $4}')"
if [ "${AVAILABLE_MB}" -lt "${MIN_FREE_MB}" ]; then
  log "ERROR: only ${AVAILABLE_MB}MB free at ${BACKUP_DIR} (minimum: ${MIN_FREE_MB}MB). Refusing to start a backup."
  exit 1
fi

# Step 1: Resolve the actual Docker volume backing RustFS's /data. Derived
# from the running container's own mounts rather than assumed from the
# compose project name, so this keeps working if the project is renamed.
CONTAINER_ID="$(docker compose -f "${COMPOSE_FILE}" ps -q "${RUSTFS_SERVICE}")"
if [ -z "${CONTAINER_ID}" ]; then
  log "ERROR: the ${RUSTFS_SERVICE} container is not running — cannot resolve its data volume."
  exit 1
fi

VOLUME_NAME="$(docker inspect "${CONTAINER_ID}" --format \
  '{% raw %}{{ range .Mounts }}{{ if eq .Destination "/data" }}{{ .Name }}{{ end }}{{ end }}{% endraw %}')"
if [ -z "${VOLUME_NAME}" ]; then
  log "ERROR: could not resolve the Docker volume mounted at ${RUSTFS_VOLUME_DEST} in the ${RUSTFS_SERVICE} container."
  exit 1
fi
log "Backing up Docker volume: ${VOLUME_NAME}"

# Step 2: Tar the volume directly via a throwaway container (read-only mount).
# No reliance on rclone/aws being installed anywhere.
TAR_FILE="${TMPDIR}/llamenos-rustfs-${TIMESTAMP}.tar.gz"
docker run --rm \
  -v "${VOLUME_NAME}:${RUSTFS_VOLUME_DEST}:ro" \
  -v "${TMPDIR}:/backup" \
  alpine:3 \
  tar -czf "/backup/$(basename "${TAR_FILE}")" -C "${RUSTFS_VOLUME_DEST}" .

OBJECT_COUNT="$(tar -tzf "${TAR_FILE}" | grep -vc '/$' || true)"
DUMP_SIZE="$(stat -c%s "${TAR_FILE}")"
log "Archived ${OBJECT_COUNT} objects, ${DUMP_SIZE} bytes"

# Step 3: Compute checksum
DUMP_SHA256="$(sha256sum "${TAR_FILE}" | cut -d' ' -f1)"

# Step 4: Encrypt with age (required — a RustFS archive can contain caller-
# submitted attachments, which must never land on disk, local or remote,
# unencrypted)
if [ -n "${AGE_RECIPIENT}" ]; then
  FILENAME="llamenos-rustfs-${TIMESTAMP}.tar.gz.age"
  log "Encrypting backup with age..."
  age -r "${AGE_RECIPIENT}" -o "${TMPDIR}/${FILENAME}" "${TAR_FILE}"
  rm -f "${TAR_FILE}"
else
  log "ERROR: No age public key configured (AGE_RECIPIENT empty). Refusing to write an unencrypted RustFS backup."
  exit 1
fi

FINAL_SIZE="$(stat -c%s "${TMPDIR}/${FILENAME}")"

# Step 5: Store in daily directory
cp "${TMPDIR}/${FILENAME}" "${BACKUP_DIR}/daily/${FILENAME}"
log "Saved to ${BACKUP_DIR}/daily/${FILENAME}"

# Step 6: Copy to weekly (Sundays) and monthly (1st)
if [ "${DAY_OF_WEEK}" = "7" ]; then
  cp "${TMPDIR}/${FILENAME}" "${BACKUP_DIR}/weekly/${FILENAME}"
  log "Weekly backup saved"
fi

if [ "${DAY_OF_MONTH}" = "01" ]; then
  cp "${TMPDIR}/${FILENAME}" "${BACKUP_DIR}/monthly/${FILENAME}"
  log "Monthly backup saved"
fi

# Step 7: Upload to remote storage via rclone
if [ -n "${RCLONE_REMOTE}" ]; then
  log "Uploading to remote storage: ${RCLONE_REMOTE}"
  rclone copy "${TMPDIR}/${FILENAME}" "${RCLONE_REMOTE}/daily/" --no-traverse
  if [ "${DAY_OF_WEEK}" = "7" ]; then
    rclone copy "${TMPDIR}/${FILENAME}" "${RCLONE_REMOTE}/weekly/" --no-traverse
  fi
  if [ "${DAY_OF_MONTH}" = "01" ]; then
    rclone copy "${TMPDIR}/${FILENAME}" "${RCLONE_REMOTE}/monthly/" --no-traverse
  fi
  log "Remote upload complete"
fi

# Step 8: Enforce retention
enforce_retention() {
  local dir="$1"
  local keep="$2"
  local pattern="$3"
  local count
  count="$(find "${dir}" -maxdepth 1 -type f -name "${pattern}" | wc -l)"
  if [ "${count}" -gt "${keep}" ]; then
    local to_delete=$(( count - keep ))
    find "${dir}" -maxdepth 1 -type f -name "${pattern}" -printf '%T@ %p\n' \
      | sort -n \
      | head -n "${to_delete}" \
      | cut -d' ' -f2- \
      | xargs rm -f
    log "Removed ${to_delete} old backups from ${dir}"
  fi
}

enforce_retention "${BACKUP_DIR}/daily" {{ backup_rustfs_retain_daily }} 'llamenos-rustfs-*'
enforce_retention "${BACKUP_DIR}/weekly" {{ backup_rustfs_retain_weekly }} 'llamenos-rustfs-*'
enforce_retention "${BACKUP_DIR}/monthly" {{ backup_rustfs_retain_monthly }} 'llamenos-rustfs-*'

# Step 9: Manifest entry
MANIFEST_ENTRY="rustfs|${TIMESTAMP}|${FILENAME}|${FINAL_SIZE}|${DUMP_SHA256}|${BACKUP_TYPE}|objects=${OBJECT_COUNT}"
echo "${MANIFEST_ENTRY}" >> "${BACKUP_DIR}/../manifest.log"

if [ "${MANIFEST_MODE}" = true ]; then
  echo "${MANIFEST_ENTRY}"
fi

log "RustFS backup complete: ${FILENAME} (${FINAL_SIZE} bytes, ${OBJECT_COUNT} objects)"
