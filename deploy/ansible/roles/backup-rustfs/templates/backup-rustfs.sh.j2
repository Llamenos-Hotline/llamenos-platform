#!/usr/bin/env bash
#
# Llamenos RustFS Backup Script — managed by Ansible
#
# Mirrors all objects from the RustFS bucket using rclone or aws s3 sync,
# then tars and optionally encrypts the result.
#
# Usage:
#   ./backup-rustfs.sh              # Run a daily backup
#   ./backup-rustfs.sh --manual     # Run and tag as manual backup
#   ./backup-rustfs.sh --manifest   # Output manifest entry to stdout

set -euo pipefail

BACKUP_DIR="{{ backup_rustfs_dir }}"
COMPOSE_FILE="{{ backup_compose_file }}"
AGE_RECIPIENT="{{ backup_age_public_key }}"
RCLONE_REMOTE="{{ backup_rclone_remote }}"
RUSTFS_BUCKET="{{ backup_rustfs_bucket }}"
TIMESTAMP="$(date -u +%Y%m%d-%H%M%S)"
DAY_OF_WEEK="$(date -u +%u)"
DAY_OF_MONTH="$(date -u +%d)"
MANIFEST_MODE=false

# Encryption is mandatory. This runs BEFORE any plaintext is written to
# disk, so a misconfigured host produces no backup rather than an
# unencrypted one. See #1125: the config archive carries every service
# .env, and both archives are uploaded to the same offsite remote, so an
# unencrypted backup ships the secrets that protect the encrypted data.
if [ -z "${AGE_RECIPIENT}" ]; then
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [rustfs] FATAL: backup_age_public_key is not set." >&2
  echo "  Refusing to write an unencrypted backup. Generate a key with" >&2
  echo "  'age-keygen -o backup-key.txt', keep the private half OFF this host," >&2
  echo "  and set backup_age_public_key in deploy/ansible/vars.yml." >&2
  exit 1
fi

BACKUP_TYPE="daily"
for arg in "$@"; do
  case "$arg" in
    --manual) BACKUP_TYPE="manual" ;;
    --manifest) MANIFEST_MODE=true ;;
  esac
done

log() {
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [rustfs] $*"
}

TMPDIR="$(mktemp -d)"
trap 'rm -rf "${TMPDIR}"' EXIT

log "Starting ${BACKUP_TYPE} RustFS backup..."

# Step 1: Archive the RustFS data volume directly.
#
# The previous implementation shelled `rclone sync s3:<bucket>` against a
# remote named "s3" that no role ever configures, with no credentials, and
# swallowed every failure with `|| true`; the `aws s3 sync` fallback ran
# inside an image that has no AWS CLI. Every branch produced an empty
# directory, which was then tarred and stored as the day's backup (#1125).
#
# RustFS persists objects as files under /data, which is a named Docker
# volume. Reading that volume with a helper container needs no S3 client,
# no credentials and no network, and it captures every object rather than
# whatever a bucket listing happened to return.
CONTAINER_ID="$(docker compose -f "${COMPOSE_FILE}" ps -q rustfs)"
if [ -z "${CONTAINER_ID}" ]; then
  log "FATAL: rustfs service is not running under ${COMPOSE_FILE}"
  exit 1
fi

{% raw %}
DATA_VOLUME="$(docker inspect \
  --format '{{ range .Mounts }}{{ if eq .Destination "/data" }}{{ .Name }}{{ end }}{{ end }}' \
  "${CONTAINER_ID}")"
{% endraw %}

if [ -z "${DATA_VOLUME}" ]; then
  log "FATAL: could not resolve the Docker volume backing /data on the rustfs container"
  exit 1
fi

log "Archiving RustFS volume ${DATA_VOLUME}"

HELPER_IMAGE="{{ backup_rustfs_helper_image | default('alpine:3.22') }}"

OBJECT_COUNT="$(docker run --rm \
  -v "${DATA_VOLUME}:/data:ro" \
  "${HELPER_IMAGE}" \
  sh -c 'find /data -type f | wc -l' | tr -d '[:space:]')"
log "RustFS volume holds ${OBJECT_COUNT} files"

# An empty result is now honest -- it means the volume really is empty,
# not that the sync tooling silently failed -- so it is a loud warning
# rather than an error, and the count goes into the manifest either way.
# The unreadable-volume and service-down cases above are hard failures,
# which is where the old "empty archive stored as today's backup" false
# confidence actually came from.
if [ "${OBJECT_COUNT}" -eq 0 ]; then
  log "WARNING: the RustFS volume contains no files. This is expected only"
  log "  on a deployment that has never stored an attachment."
fi

# Step 2: Stream the volume out as a tarball.
#
# The helper container runs as root (it has to, to read objects the
# service wrote), so it must not create files in this script's working
# directory: this script runs as the unprivileged deploy user, and a
# root-owned staging tree here makes the cleanup below fail with EPERM.
# Writing the tar to the redirect means the archive is created by THIS
# shell, owned by the right user, with no intermediate copy on disk.
#
# The volume is mounted read-only, so the running service is untouched.
# Objects written mid-archive may be missed -- the same window any
# filesystem-level snapshot has. The pg_dump is the consistency anchor,
# and attachments are immutable once written.
TAR_FILE="${TMPDIR}/llamenos-rustfs-${TIMESTAMP}.tar.gz"
docker run --rm \
  -v "${DATA_VOLUME}:/data:ro" \
  "${HELPER_IMAGE}" \
  tar -czf - -C /data . > "${TAR_FILE}"

DUMP_SIZE="$(stat -c%s "${TAR_FILE}")"
log "Compressed archive: ${DUMP_SIZE} bytes"

# Step 3: Compute checksum
DUMP_SHA256="$(sha256sum "${TAR_FILE}" | cut -d' ' -f1)"

# Step 4: Encrypt with age (if configured)
FILENAME="llamenos-rustfs-${TIMESTAMP}.tar.gz.age"
log "Encrypting backup with age..."
age -r "${AGE_RECIPIENT}" -o "${TMPDIR}/${FILENAME}" "${TAR_FILE}"
rm -f "${TAR_FILE}"

FINAL_SIZE="$(stat -c%s "${TMPDIR}/${FILENAME}")"

# Step 5: Store in daily directory
cp "${TMPDIR}/${FILENAME}" "${BACKUP_DIR}/daily/${FILENAME}"
log "Saved to ${BACKUP_DIR}/daily/${FILENAME}"

# Step 6: Copy to weekly (Sundays) and monthly (1st)
if [ "${DAY_OF_WEEK}" = "7" ]; then
  cp "${TMPDIR}/${FILENAME}" "${BACKUP_DIR}/weekly/${FILENAME}"
  log "Weekly backup saved"
fi

if [ "${DAY_OF_MONTH}" = "01" ]; then
  cp "${TMPDIR}/${FILENAME}" "${BACKUP_DIR}/monthly/${FILENAME}"
  log "Monthly backup saved"
fi

# Step 7: Upload to remote storage via rclone
if [ -n "${RCLONE_REMOTE}" ]; then
  log "Uploading to remote storage: ${RCLONE_REMOTE}"
  rclone copy "${TMPDIR}/${FILENAME}" "${RCLONE_REMOTE}/daily/" --no-traverse
  if [ "${DAY_OF_WEEK}" = "7" ]; then
    rclone copy "${TMPDIR}/${FILENAME}" "${RCLONE_REMOTE}/weekly/" --no-traverse
  fi
  if [ "${DAY_OF_MONTH}" = "01" ]; then
    rclone copy "${TMPDIR}/${FILENAME}" "${RCLONE_REMOTE}/monthly/" --no-traverse
  fi
  log "Remote upload complete"
fi

# Step 8: Enforce retention
enforce_retention() {
  local dir="$1"
  local keep="$2"
  local pattern="$3"
  local count
  count="$(find "${dir}" -maxdepth 1 -type f -name "${pattern}" | wc -l)"
  if [ "${count}" -gt "${keep}" ]; then
    local to_delete=$(( count - keep ))
    find "${dir}" -maxdepth 1 -type f -name "${pattern}" -printf '%T@ %p\n' \
      | sort -n \
      | head -n "${to_delete}" \
      | cut -d' ' -f2- \
      | xargs rm -f
    log "Removed ${to_delete} old backups from ${dir}"
  fi
}

enforce_retention "${BACKUP_DIR}/daily" {{ backup_rustfs_retain_daily }} 'llamenos-rustfs-*'
enforce_retention "${BACKUP_DIR}/weekly" {{ backup_rustfs_retain_weekly }} 'llamenos-rustfs-*'
enforce_retention "${BACKUP_DIR}/monthly" {{ backup_rustfs_retain_monthly }} 'llamenos-rustfs-*'

# Step 9: Manifest entry
MANIFEST_ENTRY="rustfs|${TIMESTAMP}|${FILENAME}|${FINAL_SIZE}|${DUMP_SHA256}|${BACKUP_TYPE}|objects=${OBJECT_COUNT}"
echo "${MANIFEST_ENTRY}" >> "${BACKUP_DIR}/../manifest.log"

if [ "${MANIFEST_MODE}" = true ]; then
  echo "${MANIFEST_ENTRY}"
fi

log "RustFS backup complete: ${FILENAME} (${FINAL_SIZE} bytes, ${OBJECT_COUNT} objects)"
