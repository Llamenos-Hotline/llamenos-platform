# Llamenos Caddyfile — managed by Ansible
# Do not edit manually; changes will be overwritten on next deploy.
#
# The API is served from the configured domain or subdomain.
# Users configure this via the `domain` and `api_subdomain` variables in vars.yml.
#
# Examples:
#   domain: "hotline.example.org", api_subdomain: "api"
#     → API served at https://api.hotline.example.org
#   domain: "hotline.example.org", api_subdomain: ""
#     → API served at https://hotline.example.org
#   domain: "192-168-1-100.nip.io", api_subdomain: ""
#     → API served at https://192-168-1-100.nip.io

# Global options.
#
# acme_ca pins issuance to Let's Encrypt ONLY. Without it Caddy's default
# issuer list falls back to ZeroSSL when Let's Encrypt fails or rate-limits,
# and a ZeroSSL certificate chains to a root the Android client does NOT pin:
# apps/android/app/src/main/res/xml/network_security_config.xml hard-fails on
# anything not chained to ISRG Root X1/X2. A silent fallback would look like a
# healthy deploy on the web and be a total outage on Android. Fail loudly at
# issuance instead. TLS must terminate here, on this box — never on a CDN.
{
    email {{ acme_email }}
    acme_ca https://acme-v02.api.letsencrypt.org/directory
{% if observability_enabled | default(false) | bool %}
    # Enables Caddy's internal Prometheus metrics collection. By itself this
    # only exposes /metrics via the admin API (loopback-bound inside this
    # container, unreachable from Prometheus's container) -- the `metrics`
    # handler in the dedicated site block below is what actually serves it
    # somewhere another container can reach (#1148).
    metrics
{% endif %}
{% if not (llamenos_disk_encrypted | default(false) | bool) %}
    # This host's disk is NOT encrypted (llamenos_disk_encrypted: false). No
    # site below enables an access log; this filter covers the lines Caddy
    # writes anyway (http.log.error on a failed proxy carries the full
    # request). Client address and URI are dropped: on the push relay the URI
    # is a device topic, so IP + topic + timestamp would be a per-volunteer
    # wake record sitting on a plaintext disk.
    log default {
        output stderr
        format filter {
            wrap json
            request>remote_ip delete
            request>remote_port delete
            request>client_ip delete
            request>uri delete
            request>headers>X-Forwarded-For delete
        }
    }
{% endif %}
}

# Security headers for threat model: nation states, right-wing groups, private hacking firms
(security_headers) {
    header {
        # Prevent downgrade attacks (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Prevent XSS
        X-XSS-Protection "1; mode=block"
        # Control referrer leakage
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict permissions
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    }
}

{#
  Split deployments run one Caddy per host, each serving only what runs on it:
  the app host serves the API (+ updater origin), the relay host serves ntfy.
  _caddy_serves_app / _caddy_serves_ntfy are set in tasks/main.yml.
#}
{% if _caddy_serves_app | bool %}
{% if api_subdomain | default("") | length > 0 %}
# Subdomain mode: API served from {{ api_subdomain }}.{{ domain }}
{{ api_subdomain }}.{{ domain }} {
    reverse_proxy app:3000
    import security_headers
}

# Root domain redirects to API subdomain
{{ domain }} {
    redir https://{{ api_subdomain }}.{{ domain }}{uri}
}
{% else %}
# Single-domain mode: API served directly from {{ domain }}
{{ domain }} {
    reverse_proxy app:3000
    import security_headers
}
{% endif %}
{% endif %}

{% if _caddy_serves_ntfy | bool and ntfy_domain | default("") | length > 0 %}
# ntfy/UnifiedPush push broker (issue #717) — reached by the Android app to
# subscribe (anonymous, read-only, keyed by an unguessable topic name) and
# used as this box's own reference for where the backend publishes to.
# Caddy proxies WebSocket upgrades automatically; no extra config needed.
# Deliberately NO `log` directive: an access log line here is
# client IP + device topic + timestamp.
{{ ntfy_domain }} {
    reverse_proxy ntfy:80
    import security_headers
}
{% endif %}

{% if _caddy_serves_app | bool and llamenos_update_server_enabled | default(false) | bool %}
# Desktop auto-updater origin (official profile). Serves the read-only artifacts
# directory bind-mounted at /srv/updates (see compose/caddy.j2):
#   /desktop/latest.json          <- tauri.conf.json plugins.updater.endpoints
#   /desktop/v<version>/<file>    <- URLs inside latest.json
# Both hostnames serve the same tree (tauri.conf.json lists both as endpoints).
# Terminated here — same box, same ISRG-chained certificate policy as the API —
# because a second Caddy could not complete ACME on ports 80/443.
{{ updates_domain }}, {{ releases_domain }} {
    root * /srv/updates

    handle /health {
        respond "ok" 200
    }

    # Short cache on the manifest so a new release is seen quickly; installers
    # live under a versioned path and can be cached a little longer.
    handle /desktop/latest.json {
        header Cache-Control "public, max-age=30"
        file_server
    }

    handle /desktop/* {
        header Cache-Control "public, max-age=60"
        file_server
    }

    handle {
        respond "Not found" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
}
{% endif %}

{% if observability_enabled | default(false) | bool %}
# Prometheus metrics, unauthenticated, on a plain-HTTP listener that is NOT
# bound to any public vhost and has no published port in compose/caddy.j2 --
# only reachable by containers on the shared llamenos-observability Docker
# network, i.e. just the prometheus container (scraped as caddy:9091, see
# roles/llamenos-prometheus/templates/prometheus.yml.j2). Deliberately not the
# admin API (:2019): that endpoint can rewrite this entire config and must stay
# loopback-only inside this container.
:9091 {
    metrics /metrics
}
{% endif %}
