name: llamenos-caddy

services:
  caddy:
    image: {{ llamenos_caddy_image | default('caddy:2.9-alpine') }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
{% if _caddy_serves_app | bool and llamenos_update_server_enabled | default(false) | bool %}
      - {{ update_artifacts_dir }}:/srv/updates:ro
{% endif %}
    environment:
      - DOMAIN={{ domain }}
      - ACME_EMAIL={{ acme_email }}
    networks:
      - llamenos-web
{% if observability_enabled | default(false) | bool %}
      - llamenos-observability
{% endif %}
    logging:
      driver: json-file
      options:
{% if llamenos_disk_encrypted | default(false) | bool %}
        max-size: "10m"
        max-file: "5"
{% else %}
        # Unencrypted disk: one small file (see the log filter in the Caddyfile).
        max-size: "1m"
        max-file: "1"
{% endif %}
        tag: "llamenos-caddy"

volumes:
  caddy-data:
  caddy-config:

networks:
  llamenos-web:
    external: true
{% if observability_enabled | default(false) | bool %}
  llamenos-observability:
    external: true
{% endif %}
