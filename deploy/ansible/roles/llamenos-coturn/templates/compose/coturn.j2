name: llamenos-coturn

services:
  coturn:
    image: {{ llamenos_coturn_image }}
    restart: unless-stopped
    # Host networking, NOT published ports. A TURN server has to advertise an
    # address the client can actually reach in its RELAY candidate, and on a
    # bridge network it advertises its 172.x container address — so the
    # allocation succeeds and the candidate is then useless, which is exactly
    # the case a symmetric-NAT volunteer depends on. Host mode is also coturn's
    # own recommended deployment, and it keeps the relay port range subject to
    # the host firewall instead of bypassing it the way published ports do.
    network_mode: host
{% if docker_userns_remap | default(false) | bool %}
    # Opt THIS container out of userns-remap, which roles/docker turns on by
    # default. Docker refuses outright otherwise: "cannot share the host's
    # network namespace when user namespaces are enabled" — measured on a
    # hardened host, and the reason the compose-path coturn service could not
    # simply be lifted onto the Ansible path.
    #
    # Host networking is not substitutable here, so this is the tradeoff and not
    # an oversight. Published ports would put docker-proxy in front of every
    # relay port, and userland proxying REWRITES the source transport address of
    # every TURN client to the bridge gateway — coturn distinguishes allocations
    # and enforces permissions by that 5-tuple, so all clients would collapse
    # into one indistinguishable peer. A relay that cannot tell its clients
    # apart is not a relay.
    #
    # Compensated below rather than merely accepted: every capability dropped
    # (coturn binds {{ turn_port }} and the relay range, all above 1024, so it
    # needs none), no privilege escalation, and a read-only root filesystem.
    userns_mode: "host"
{% endif %}
    cap_drop:
      - ALL
    cap_add:
      # NET_BIND_SERVICE and nothing else, and it is needed for a reason that is
      # not the obvious one: /usr/bin/turnserver carries it as a FILE
      # capability, so dropping it from the bounding set makes the kernel refuse
      # the exec itself. MEASURED by bisection on the hardened host — a bare
      # `cap_drop: ALL` restart-loops with
      # "/usr/local/bin/docker-entrypoint.sh: /usr/bin/turnserver: Operation not
      # permitted", and adding NET_RAW, NET_ADMIN or DAC_OVERRIDE does not help
      # while NET_BIND_SERVICE alone does. The image already runs as uid 65534
      # (nobody) and its entrypoint only execs, so no SETUID/SETGID is wanted.
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /var/tmp:size=8M
    # Time-limited per-volunteer credentials (the RFC 8489 long-term-credential
    # REST convention): the worker mints `username = <expiry>:<vol_…>` /
    # `credential = base64(HMAC-SHA1(TURN_SECRET, username))` for
    # /api/telephony/sip-token (apps/worker/telephony/registrar.ts
    # `mintTurnCredentials`), and coturn verifies them against the shared
    # --static-auth-secret below. The secret never leaves the server side, and a
    # seized client credential dies at its expiry. So TURN_SECRET here and
    # TURN_SECRET in the app's .env MUST be the same value — they are, because
    # both render from `turn_secret`.
    #
    # No --no-auth and no --lt-cred-mech: an open relay is abuse infrastructure,
    # and this one is reachable from the internet by design.
    #
    # --listening-ip/--relay-ip are pinned explicitly. Without them coturn
    # enumerates every host interface — each docker bridge included — logs
    # "NO EXPLICIT RELAY ADDRESS(ES) ARE CONFIGURED", and may source the RTCP
    # component of an allocation from an address its relay candidate never
    # named, which an ICE peer is entitled to reject (#1689: one-way/absent
    # audio on a call that connected). The loopback listener exists so the
    # healthcheck below (a STUN binding request against 127.0.0.1) and
    # in-container turnutils still work; --relay-ip is explicit, so no relay
    # candidate is ever allocated on loopback.
    #
    # --log-file=stdout: coturn's default log target is a /var/tmp file (the
    # tmpfs above), which the json-file driver — and the smoke check that greps
    # `docker compose logs` for the NO EXPLICIT RELAY ADDRESS warning — would
    # never see. stdout is also where an operator looks first.
    command: >
      --realm={{ turn_realm }}
      --fingerprint
      --use-auth-secret
      --static-auth-secret={{ turn_secret }}
      --listening-port={{ turn_port }}
      --min-port={{ turn_relay_min_port }}
      --max-port={{ turn_relay_max_port }}
      --listening-ip={{ turn_listening_ip }}
      --relay-ip={{ turn_relay_ip }}
{% if turn_listening_ip != '127.0.0.1' %}
      --listening-ip=127.0.0.1
{% endif %}
{% if (turn_external_ip | default('')) | length > 0 %}
      --external-ip={{ turn_external_ip }}
{% endif %}
      --no-tls
      --no-dtls
      --no-cli
      --log-file=stdout
    # A STUN Binding request, which coturn answers UNAUTHENTICATED even in
    # --use-auth-secret mode (only a TURN allocation needs the credential). So
    # unlike a process probe this proves the listener actually answers. A dead
    # listener never replies, so the probe hangs and the timeout fails it.
    healthcheck:
      test: ["CMD-SHELL", "turnutils_stunclient -p {{ turn_port }} 127.0.0.1 2>&1 | grep -q 'reflexive addr'"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
