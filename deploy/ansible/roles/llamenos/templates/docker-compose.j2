{% set pg_e2e_publish = (dev_routes_enabled | default(false) | bool) and (app_environment | default('production')) != 'production' %}
{% set pg_e2e_network = 'e2e-db' %}
name: llamenos

services:
  app:
    image: {{ llamenos_app_image }}
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:size=64M
    # All application env vars are rendered once, in one place, by env.j2 ->
    # .env (see roles/llamenos/tasks/main.yml). Previously this list duplicated
    # a subset of that file inline and .env was never actually loaded by
    # Compose (no env_file / no ${VAR} substitution), so any var added only to
    # env.j2 silently never reached the container (issue #716). env_file is
    # the single source of truth now — do not add an `environment:` list back
    # here for the app service.
    env_file:
      - .env
{% if (kamailio_enabled | default(false) | bool) and (kamailio_tls_enabled | default(true) | bool) and (kamailio_tls_publish_anchor | default(true) | bool) %}
    # The SIP edge's PUBLIC trust anchor the app publishes to clients in
    # /api/telephony/sip-token (SIP_TLS_CA_FILE in .env). Same mount, same
    # reasoning, as roles/llamenos-app/templates/compose/app.j2 — see the long
    # note there. Read-only, directory not file, certificate only.
    volumes:
      - {{ kamailio_tls_anchor_dir | default(app_dir ~ '/services/kamailio/anchor') }}:{{ sip_tls_anchor_container_path | default('/var/lib/llamenos/sip-tls') }}:ro
{% endif %}
    # Loopback-only publish, matching roles/llamenos-app's compose. The host
    # has to be able to reach the app directly for two reasons: the "Wait for
    # application health check" task in this role probes
    # http://localhost:3000/api/health from the host, and SSH tunnelling is
    # the intended way an operator reaches the app (Caddy fronts it publicly).
    # Without this the app was only on the internal Docker network, so that
    # probe failed on every demo deploy while the container itself was
    # healthy (issue #1602, finding 1). NOT 0.0.0.0 — the port must not be
    # reachable from off the host; Caddy is the only public entrypoint.
    ports:
      - "127.0.0.1:3000:3000"
    networks:
      - web
      - internal
    depends_on:
      postgres:
        condition: service_healthy
      rustfs:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
        tag: "llamenos-app"
    healthcheck:
      test: ["CMD", "bun", "-e", "fetch('http://localhost:3000/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

  postgres:
    image: {{ llamenos_postgres_image | default('postgres:17-alpine') }}
    restart: unless-stopped
    volumes:
      - postgres-data:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=llamenos
      - POSTGRES_USER=llamenos
      - POSTGRES_PASSWORD={{ pg_password }}
    networks:
      - internal
{#
  The end-to-end suite asserts persisted state straight from PostgreSQL
  (tests/db-helpers.ts), so against a DEPLOYED target it has to be able to
  reach this database — and by default nothing can: no port is published, which
  is correct for every host that serves real callers.

  Publishing it on 127.0.0.1 ONLY, and only on an E2E target, is the narrowest
  thing that makes the suite possible. Loopback means nothing off the host can
  connect even with the password; the operator carries it to the test runner
  over SSH (`ssh -L`), which is already the administrative channel for this box.
  See docs/deploy/E2E_AGAINST_A_DEPLOYMENT.md.

  Tied to `dev_routes_enabled` deliberately rather than given a switch of its
  own: that flag already means "this is the throwaway target the suite resets",
  and a second independent knob would let the database be exposed on a host
  where the suite cannot run anyway. The `app_environment != 'production'` arm
  is the same belt-and-braces as templates/env/_worker-required-env.j2 —
  playbooks/tasks/guard-dev-routes.yml already refuses that combination outright.

  NOTE: this monolithic role is deprecated and its only consumer is
  playbooks/deploy-demo.yml, which is being removed with demo mode. Both shapes
  a real deployment takes run playbooks/deploy.yml -> the per-service roles, so
  roles/llamenos-postgres/templates/compose/postgres.j2 is the copy that
  matters. This one is kept in step only so the two do not diverge while both
  exist (scripts/check-required-env.py renders and checks both).

  The extra network is NOT optional and NOT cosmetic HERE: this role's
  `internal` network really is `internal: true` (see the bottom of this file).
  Docker cannot publish a host port for a container attached only to such a
  network: it accepts the `ports:` entry, records the binding in the container,
  installs NO DNAT rule, and nothing ever listens. Measured on a real deploy —
  `docker inspect` reported `127.0.0.1:5432`, `iptables -t nat -S` had no rule
  for it, and the port was closed. A `ports:` entry alone would therefore be a
  silent no-op that LOOKS configured, which is the exact false-green this whole
  change exists to prevent. `{{ pg_e2e_network }}` is an ordinary bridge with no
  published service of its own; the loopback host binding is still the only way
  in from outside the host.
#}
{% if pg_e2e_publish %}
      - {{ pg_e2e_network }}
    ports:
      - "127.0.0.1:{{ pg_e2e_loopback_port | default(5432) }}:5432"
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U llamenos -d llamenos"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  caddy:
    image: {{ llamenos_caddy_image | default('caddy:2.9-alpine') }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    environment:
      - DOMAIN={{ domain }}
      - ACME_EMAIL={{ acme_email }}
    networks:
      - web
    depends_on:
      app:
        condition: service_healthy

{% if llamenos_ntfy_enabled | default(false) | bool %}
  # ntfy/UnifiedPush push relay — Android testers cannot be woken for an
  # incoming call without it (issue #959). Service body is shared with
  # roles/llamenos-ntfy so auth/ACL settings cannot drift between deploy
  # paths. Provisioned (publish token + ACLs) by roles/llamenos/tasks/main.yml
  # before the .env is rendered.
  ntfy:
{{ lookup('ansible.builtin.template', playbook_dir ~ '/../roles/llamenos-ntfy/templates/compose/_ntfy-service.j2') | indent(4, first=true) }}
    ports:
      # Loopback-only — local health check + `ntfy` CLI provisioning.
      - "127.0.0.1:{{ llamenos_ntfy_local_port | default(2586) }}:80"
    networks:
      - web
      - internal

{% endif %}
  rustfs:
    image: {{ llamenos_rustfs_image | default('rustfs/rustfs:latest') }}
    command: server /data --console-address ":9001"
    restart: unless-stopped
    volumes:
      - rustfs-data:/data
    environment:
      - RUSTFS_ACCESS_KEY={{ storage_access_key }}
      - RUSTFS_SECRET_KEY={{ storage_secret_key }}
      - RUSTFS_CONSOLE_ENABLE=true
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9000/ || test $? -eq 22"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

volumes:
  postgres-data:
  caddy-data:
  caddy-config:
  rustfs-data:
{% if llamenos_ntfy_enabled | default(false) | bool %}
  ntfy-data:
{% endif %}

networks:
  web:
    driver: bridge
  internal:
    driver: bridge
    internal: true
{% if pg_e2e_publish %}
  {{ pg_e2e_network }}:
    driver: bridge
{% endif %}
