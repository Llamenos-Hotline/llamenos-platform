name: llamenos

services:
  app:
    image: {{ llamenos_app_image }}
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:size=64M
    # All application env vars are rendered once, in one place, by env.j2 ->
    # .env (see roles/llamenos/tasks/main.yml). Previously this list duplicated
    # a subset of that file inline and .env was never actually loaded by
    # Compose (no env_file / no ${VAR} substitution), so any var added only to
    # env.j2 silently never reached the container (issue #716). env_file is
    # the single source of truth now — do not add an `environment:` list back
    # here for the app service.
    env_file:
      - .env
    # Loopback-only publish, matching roles/llamenos-app's compose. The host
    # has to be able to reach the app directly for two reasons: the "Wait for
    # application health check" task in this role probes
    # http://localhost:3000/api/health from the host, and SSH tunnelling is
    # the intended way an operator reaches the app (Caddy fronts it publicly).
    # Without this the app was only on the internal Docker network, so that
    # probe failed on every demo deploy while the container itself was
    # healthy (issue #1602, finding 1). NOT 0.0.0.0 — the port must not be
    # reachable from off the host; Caddy is the only public entrypoint.
    ports:
      - "127.0.0.1:3000:3000"
    networks:
      - web
      - internal
    depends_on:
      postgres:
        condition: service_healthy
      rustfs:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
        tag: "llamenos-app"
    healthcheck:
      test: ["CMD", "bun", "-e", "fetch('http://localhost:3000/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

  postgres:
    image: {{ llamenos_postgres_image | default('postgres:17-alpine') }}
    restart: unless-stopped
    volumes:
      - postgres-data:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=llamenos
      - POSTGRES_USER=llamenos
      - POSTGRES_PASSWORD={{ pg_password }}
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U llamenos -d llamenos"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  caddy:
    image: {{ llamenos_caddy_image | default('caddy:2.9-alpine') }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    environment:
      - DOMAIN={{ domain }}
      - ACME_EMAIL={{ acme_email }}
    networks:
      - web
    depends_on:
      app:
        condition: service_healthy

{% if llamenos_ntfy_enabled | default(false) | bool %}
  # ntfy/UnifiedPush push relay — Android testers cannot be woken for an
  # incoming call without it (issue #959). Service body is shared with
  # roles/llamenos-ntfy so auth/ACL settings cannot drift between deploy
  # paths. Provisioned (publish token + ACLs) by roles/llamenos/tasks/main.yml
  # before the .env is rendered.
  ntfy:
{{ lookup('ansible.builtin.template', playbook_dir ~ '/../roles/llamenos-ntfy/templates/compose/_ntfy-service.j2') | indent(4, first=true) }}
    ports:
      # Loopback-only — local health check + `ntfy` CLI provisioning.
      - "127.0.0.1:{{ llamenos_ntfy_local_port | default(2586) }}:80"
    networks:
      - web
      - internal

{% endif %}
  rustfs:
    image: {{ llamenos_rustfs_image | default('rustfs/rustfs:latest') }}
    command: server /data --console-address ":9001"
    restart: unless-stopped
    volumes:
      - rustfs-data:/data
    environment:
      - RUSTFS_ACCESS_KEY={{ storage_access_key }}
      - RUSTFS_SECRET_KEY={{ storage_secret_key }}
      - RUSTFS_CONSOLE_ENABLE=true
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9000/ || test $? -eq 22"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

volumes:
  postgres-data:
  caddy-data:
  caddy-config:
  rustfs-data:
{% if llamenos_ntfy_enabled | default(false) | bool %}
  ntfy-data:
{% endif %}

networks:
  web:
    driver: bridge
  internal:
    driver: bridge
    internal: true
