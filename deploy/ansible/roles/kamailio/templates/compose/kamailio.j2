name: llamenos-kamailio

services:
  kamailio:
    # NOTE: "kamailio/kamailio" does not exist on Docker Hub and ":5.7" was
    # never a published tag anywhere (see #722). Pinned to the official
    # ghcr.io/kamailio/kamailio:5.7.1-bookworm image (earliest published
    # 5.7.x patch). scripts/update-image-digests.sh is owned by a different
    # lane and still lists the old ref; needs a follow-up from that lane so
    # refreshes don't revert this pin.
    image: ghcr.io/kamailio/kamailio:5.7.1-bookworm@sha256:a5c0564fe4bf12315ec3aed97303bc63207c0cec0c5b1150ea6500f4747163e9  # pinned 2026-09-19
    restart: unless-stopped
    ports:
      - "5060:5060/udp"
      - "5060:5060/tcp"
      - "5061:5061/tcp"
    volumes:
      # `./config/`, not `./`: tasks/main.yml templates all three into
      # {{ app_dir }}/services/kamailio/config/, so the old paths named files
      # that do not exist — Docker then created each as an empty DIRECTORY and
      # the container died with "Are you trying to mount a directory onto a
      # file". Never seen because this role was on no deploy path until #1657
      # put it on one.
      - ./config/kamailio.cfg:/etc/kamailio/kamailio.cfg:ro
      - ./config/dispatcher.list:/etc/kamailio/dispatcher.list:ro
      - ./config/tls.cfg:/etc/kamailio/tls.cfg:ro
{% if kamailio_tls_enabled | default(true) | bool %}
      # The TLS material tls.cfg names. WITHOUT this mount the certificate is
      # generated on the host and the container cannot see it, so the TLS
      # listener never binds — which is what happened before this line existed.
      #
      # Read-only: Kamailio only ever reads it, and when the source is an
      # externally-managed (e.g. Let's Encrypt) directory it is not ours to
      # write to. A renewal in that directory is picked up by the
      # llamenos-sip-tls-reload timer, not by a restart.
      - {{ kamailio_tls_cert_source_dir | default(kamailio_tls_dir) }}:{{ kamailio_tls_container_dir }}:ro
{% endif %}
    networks:
      - llamenos-internal
    healthcheck:
      test: ["CMD", "kamcmd", "core.version"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  llamenos-internal:
    external: true
